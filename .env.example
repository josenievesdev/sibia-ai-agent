# Negocio que atiende SIBIA. Aparece en la bienvenida de la consola y en el
# prompt del sistema. Si se deja vacío, SIBIA dice "esta tienda".
SIBIA_BUSINESS_NAME=Tienda La Esquina

# API local
APP_HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Ollama: SIBIA usa exclusivamente este modelo en esta etapa.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=ministral-3:8b
OLLAMA_CHAT_TIMEOUT_MS=120000
# Contexto del modelo. El valor por defecto de Ollama (4096) no alcanza para
# el prompt de SIBIA mas las definiciones de tools mas un resultado de tool.
# 6144 mantiene ministral-3:8b al 100% en GPU; subirlo puede repartirlo con
# la CPU y volverlo mucho mas lento. Ajustar segun la VRAM disponible.
OLLAMA_NUM_CTX=6144
# Logs opcionales del cliente de Ollama por stderr.
SIBIA_DEBUG=0
INTEGRATION_CHECK_TIMEOUT_MS=5000

# Nuevo proyecto Supabase. Dejar ambos valores vacíos hasta crearlo.
# No usar una service_role key en el backend de esta etapa.
# La interfaz web reutiliza estas dos variables: el backend entrega al
# navegador solo la URL y la publishable key; nunca las variables de Telegram.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Canal Telegram por long polling local. Estas variables solo son obligatorias
# al ejecutar npm run telegram. El token se obtiene de @BotFather.
TELEGRAM_BOT_TOKEN=
# IDs numéricos separados por comas. Puede dejarse vacío temporalmente para
# iniciar el bot y consultar /id; ningún otro comando ni consulta será aceptado.
TELEGRAM_ALLOWED_USER_IDS=
# Cuenta dedicada de Supabase Auth con perfil activo y rol de negocio admin.
# Nunca usar service_role ni enviar estas credenciales por Telegram.
TELEGRAM_SUPABASE_EMAIL=
TELEGRAM_SUPABASE_PASSWORD=
